{
  "description": "MCP configuration for ln-agent (add to Claude Desktop config or Claude Code settings)",
  "mcpServers": {
    "ln-agent": {
      "command": "ssh",
      "args": [
        "-i", "~/.ssh/ln-agent-poc",
        "-o", "StrictHostKeyChecking=accept-new",
        "-L", "18789:localhost:18789",
        "-L", "8081:localhost:8081",
        "ubuntu@${LN_AGENT_IP}",
        "docker", "exec", "-i", "openclaw-agent",
        "openclaw", "acp",
        "--token", "<YOUR_OPENCLAW_ACP_TOKEN>"
      ],
      "env": {
        "LN_AGENT_IP": "<YOUR_EC2_IP>"
      }
    }
  }
}
