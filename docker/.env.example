# === OpenClaw Agent Environment Variables ===
# このファイルをコピーして .env を作成
# cp .env.example .env

# --- LND Connection ---
LND_GRPC_HOST=lnd:10009
LND_TLS_CERT_PATH=/lnd/tls.cert
LND_MACAROON_PATH=/lnd/data/chain/bitcoin/mainnet/admin.macaroon

# --- LLM Config ---
# Not required: use `claude` CLI with OAuth instead of API key.
# Run `claude login` on EC2 after setup (browser-based OAuth, no API key needed).
# If you prefer API key auth, uncomment:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=<YOUR_ANTHROPIC_API_KEY>
# LLM_MODEL=claude-sonnet-4-6

# --- Agent Config ---
AGENT_NAME=ln-agent-kohei
AGENT_NETWORK=mainnet
AGENT_LOG_LEVEL=info

# --- Safety Limits (Mainnet) ---
AGENT_MAX_SINGLE_PAYMENT_SATS=50000
AGENT_DAILY_SPEND_LIMIT_SATS=200000
AGENT_MAX_CHANNEL_SIZE_SATS=1000000
AGENT_MAX_CHANNELS_PER_DAY=2
AGENT_REQUIRE_CONFIRM_ABOVE_SATS=50000

# --- Logging ---
LOG_DIR=/var/log/openclaw
