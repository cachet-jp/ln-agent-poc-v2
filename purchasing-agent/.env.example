# =============================================================================
# Purchasing Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Minimum required: CASHU_MINT_URL (for Cashu-only mode)
# =============================================================================

# -----------------------------------------------------------------------------
# Cashu ecash (Required for Cashu-only mode)
# -----------------------------------------------------------------------------

# Cashu Mint URL — the mint that holds and pays your ecash
CASHU_MINT_URL=https://mint.minibits.cash/Bitcoin

# Encryption key for local proof storage (64-char hex)
# If not set, derived from CLW_SESSION_TOKEN via HKDF
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASHU_STORE_KEY=

# Maximum ecash balance in sats (safety limit)
CASHU_MAX_BALANCE_SATS=1000000

# Use Cashu as preferred payment method (true/false)
CASHU_PREFERRED=true

# -----------------------------------------------------------------------------
# Safety Guardrails
# -----------------------------------------------------------------------------

# Maximum single purchase amount in JPY
MAX_SPEND_JPY=5000

# -----------------------------------------------------------------------------
# Browser Automation
# -----------------------------------------------------------------------------

# Run Playwright in headless mode (true/false)
# Set to false for debugging
HEADLESS=true

# -----------------------------------------------------------------------------
# Ark Wallet (Optional — for Ark+Cashu hybrid mode)
# -----------------------------------------------------------------------------

# Enable Ark / claw-cash integration. OFF by default — when off, ark_* tools
# and cashu_mint_tokens are not registered, and payment-strategy never falls
# back to Ark. Top up via cashu_create_invoice + cashu_claim_invoice instead.
# Set to "true" only when claw-cash is built, configured, and funded.
ARK_ENABLED=false

# CLW API base URL
CLW_API_BASE_URL=https://api.clw.cash

# CLW session token (from clw.cash wallet)
# CLW_SESSION_TOKEN=

# CLW identity UUID
# CLW_IDENTITY_ID=

# CLW compressed public key
# CLW_PUBLIC_KEY=

# Ark server URL
# CLW_ARK_SERVER_URL=https://arkade.computer

# -----------------------------------------------------------------------------
# UseBitcoin.jp REST API (Required for usebitcoin_buy_* tools)
# -----------------------------------------------------------------------------
# Get your API key from UseBitcoin.jp after signing up.

USEBITCOIN_API_KEY=

# Optional override (defaults to https://usebitcoin.jp/api/v1)
# USEBITCOIN_API_BASE_URL=https://usebitcoin.jp/api/v1

# -----------------------------------------------------------------------------
# Bitrefill (Optional — for Bitrefill gift card/eSIM purchases)
# -----------------------------------------------------------------------------
# Get your API key at: https://www.bitrefill.com/account/developers
# Or run `bitrefill` CLI without a key to trigger browser-based OAuth.

# Single API key (recommended, used by @bitrefill/cli)
# BITREFILL_API_KEY=

# Alternative: ID + SECRET pair (used by official bitrefill-mcp-server)
# Only needed if using the official MCP server in .mcp.json.
# BITREFILL_API_ID=
# BITREFILL_API_SECRET=

# -----------------------------------------------------------------------------
# Amazon (Optional — Phase 1+)
# -----------------------------------------------------------------------------

# AMAZON_EMAIL=
# AMAZON_PASSWORD=
