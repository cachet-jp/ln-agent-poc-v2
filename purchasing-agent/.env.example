# =============================================================================
# Purchasing Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Minimum required: CASHU_MINT_URL
# =============================================================================

# -----------------------------------------------------------------------------
# Cashu ecash (Required)
# -----------------------------------------------------------------------------

# Cashu Mint URL — the mint that holds and pays your ecash
CASHU_MINT_URL=https://mint.minibits.cash/Bitcoin

# Encryption key for local proof storage (64-char hex).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASHU_STORE_KEY=

# Maximum ecash balance in sats (safety limit)
CASHU_MAX_BALANCE_SATS=1000000

# Use Cashu as preferred payment method (true/false)
CASHU_PREFERRED=true

# -----------------------------------------------------------------------------
# Safety Guardrails
# -----------------------------------------------------------------------------

# Maximum single purchase amount in JPY
MAX_SPEND_JPY=5000

# Absolute per-payment ceiling in sats, enforced at the Cashu melt chokepoint
# independent of any vendor-quoted price. Backstops every payment path against
# an inflated invoice (compromised/MITM vendor) or a runaway agent loop.
# Tune to your wallet and the largest single purchase you expect to make.
MAX_SPEND_SATS=100000

# -----------------------------------------------------------------------------
# Browser Automation (V-Preca inquiry uses Playwright against Lifecard)
# -----------------------------------------------------------------------------

# Run Playwright in headless mode (true/false). Set to false for debugging.
HEADLESS=true

# -----------------------------------------------------------------------------
# UseBitcoin.jp REST API (Required for usebitcoin_buy_* tools)
# -----------------------------------------------------------------------------
# This is a shared public key (no signup needed); it works out of the box.

USEBITCOIN_API_KEY=c260bb8dfa012c8e2fe7d958b2e14abe

# Optional override (defaults to https://usebitcoin.jp/api/v1)
# USEBITCOIN_API_BASE_URL=https://usebitcoin.jp/api/v1

# -----------------------------------------------------------------------------
# Bitrefill (Optional — for Bitrefill gift card/eSIM purchases)
# -----------------------------------------------------------------------------
# Get your API key at: https://www.bitrefill.com/account/developers
# Or run `bitrefill` CLI without a key to trigger browser-based OAuth.

# Single API key (recommended, used by @bitrefill/cli)
# BITREFILL_API_KEY=

# Alternative: ID + SECRET pair (used by official bitrefill-mcp-server)
# Only needed if using the official MCP server in .mcp.json.
# BITREFILL_API_ID=
# BITREFILL_API_SECRET=

# Optional: absolute path to the @bitrefill/cli binary. When set, the agent runs
# exactly this binary instead of resolving `bitrefill` from PATH (prevents a
# PATH-hijack from receiving BITREFILL_API_KEY). Find it with `which bitrefill`.
# BITREFILL_CLI_PATH=/usr/local/bin/bitrefill
