# =============================================================================
# Purchasing Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Minimum required: CASHU_MINT_URL (for Cashu-only mode)
# =============================================================================

# -----------------------------------------------------------------------------
# Cashu ecash (Required for Cashu-only mode)
# -----------------------------------------------------------------------------

# Cashu Mint URL — the mint that holds and pays your ecash
CASHU_MINT_URL=https://mint.minibits.cash/Bitcoin

# Encryption key for local proof storage (64-char hex)
# If not set, derived from CLW_SESSION_TOKEN via HKDF
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASHU_STORE_KEY=

# Maximum ecash balance in sats (safety limit)
CASHU_MAX_BALANCE_SATS=1000000

# Use Cashu as preferred payment method (true/false)
CASHU_PREFERRED=true

# -----------------------------------------------------------------------------
# Safety Guardrails
# -----------------------------------------------------------------------------

# Maximum single purchase amount in JPY
MAX_SPEND_JPY=5000

# -----------------------------------------------------------------------------
# Browser Automation
# -----------------------------------------------------------------------------

# Run Playwright in headless mode (true/false)
# Set to false for debugging
HEADLESS=true

# -----------------------------------------------------------------------------
# Ark Wallet (Optional — for Ark+Cashu hybrid mode)
# -----------------------------------------------------------------------------

# CLW API base URL
CLW_API_BASE_URL=https://api.clw.cash

# CLW session token (from clw.cash wallet)
# CLW_SESSION_TOKEN=

# CLW identity UUID
# CLW_IDENTITY_ID=

# CLW compressed public key
# CLW_PUBLIC_KEY=

# Ark server URL
# CLW_ARK_SERVER_URL=https://arkade.computer

# -----------------------------------------------------------------------------
# Amazon (Optional — Phase 1+)
# -----------------------------------------------------------------------------

# AMAZON_EMAIL=
# AMAZON_PASSWORD=
