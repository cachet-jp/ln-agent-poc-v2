{
  "mcpServers": {
    "purchasing-agent": {
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.volta/bin:$HOME/.fnm:$HOME/.local/share/fnm:/opt/homebrew/bin:/usr/local/bin:$PATH\" && exec npx tsx src/server.ts"
      ],
      "cwd": "purchasing-agent",
      "env": {
        "NODE_ENV": "development"
      }
    },
    "bitrefill": {
      "command": "bash",
      "args": [
        "-c",
        "export PATH=\"$HOME/.volta/bin:$HOME/.fnm:$HOME/.local/share/fnm:/opt/homebrew/bin:/usr/local/bin:$PATH\" && exec npx -y bitrefill-mcp-server"
      ],
      "env": {
        "BITREFILL_API_ID": "",
        "BITREFILL_API_SECRET": ""
      }
    }
  }
}
