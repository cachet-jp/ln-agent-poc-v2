{
  "mcpServers": {
    "purchasing-agent": {
      "command": "npx",
      "args": ["tsx", "src/server.ts"],
      "cwd": "purchasing-agent",
      "env": {
        "NODE_ENV": "development"
      }
    },
    "bitrefill": {
      "command": "npx",
      "args": ["-y", "bitrefill-mcp-server"],
      "env": {
        "BITREFILL_API_ID": "",
        "BITREFILL_API_SECRET": ""
      }
    }
  }
}
