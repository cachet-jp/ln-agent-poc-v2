{
  "mcpServers": {
    "purchasing-agent": {
      "command": "bash",
      "args": [
        "-ilc",
        "cd purchasing-agent && exec pnpm dev"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    },
    "bitrefill": {
      "command": "bash",
      "args": [
        "-ilc",
        "exec npx -y bitrefill-mcp-server"
      ],
      "env": {
        "BITREFILL_API_ID": "",
        "BITREFILL_API_SECRET": ""
      }
    }
  }
}
